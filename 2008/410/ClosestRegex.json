    {
      "args": [
        "abfjdsjdhfsjfksdkjfywekjdssgkjkjjksjk",
        "j*h*f*z*d*g*d*d*d*s*f*fsg*f*fg*s*s*d*a*z*a*h*z*t*e"
      ],
      "expected": "jjjjjjjhhfsfffsffffffffffssssssssssae"
    }
  ]
}
