        "abcd",
        "bcdd"
      ],
      "expected": "bcdd"
    },
    {
      "args": [
        "topcoder",
        "t*px*coa*de*"
      ],
      "expected": "ttpcodee"
    },
    {
      "args": [
        "cmu",
        "c*m*fm*u*"
      ],
      "expected": "cfu"
    },
    {
      "args": [
        "aaaaacccc",
        "a*abc*"
      ],
      "expected": "aaaaabccc"
    },
    {
      "args": [
        "short",
        "lo*ts*of*let*ter*s"
      ],
      "expected": ""
    },
    {
      "args": [
        "abc",
        "def"
      ],
      "expected": "def"
    },
    {
      "args": [
        "abc",
        "ab"
      ],
      "expected": ""
    },
    {
      "args": [
        "abc",
        "ab*cd"
      ],
      "expected": "acd"
    },
    {
      "args": [
        "cbc",
        "a*b*"
      ],
      "expected": "abb"
    },
    {
      "args": [
        "acde",
        "a*bcde*"
      ],
      "expected": "bcde"
    },
    {
      "args": [
        "z",
        "a*"
      ],
      "expected": "a"
    },
    {
      "args": [
        "a",
        "z*"
      ],
      "expected": "z"
    },
    {
      "args": [
        "p",
        "p*"
      ],
      "expected": "p"
    },
    {
      "args": [
        "x",
        "x"
      ],
      "expected": "x"
    },
    {
      "args": [
        "x",
        "y"
      ],
      "expected": "y"
    },
    {
      "args": [
        "ababababababababababababababababababababababababab",
        "a*b*a*b*a*b*a*b*a*b*a*b*a*b*a*b*a*b*a*b*a*b*a*b*a*"
      ],
      "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaabababababababababababab"
