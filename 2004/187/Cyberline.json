{
  "method": "lastCyberword",
  "cases": [
    {
      "args": [
        "Zowie: This is a line of##cyber-poetry## !"
      ],
      "expected": "cyberpoetry"
    },
    {
      "args": [
        "2-b|!2-b -- ?"
      ],
      "expected": "2b"
    },
    {
      "args": [
        "if then{}; elseif schmelshif();"
      ],
      "expected": "schmelshif"
    },
    {
      "args": [
        "~y?"
      ],
      "expected": "y"
    },
    {
      "args": [
        "y#/ y#: !!! y~#keys&h4x-h4x-h4x?"
      ],
      "expected": "h4xh4xh4x"
    },
    {
      "args": [
        "@$%#$#)%(#&$){$@!}"
      ],
      "expected": "@"
    },
    {
      "args": [
        "a!ing&#ing.=?"
      ],
      "expected": "ing"
    },
    {
      "args": [
        "froggly doggly blogly"
      ],
      "expected": "blogly"
    },
    {
      "args": [
        "abcdefg-high-phen--ing"
      ],
      "expected": "abcdefghighphening"
    },
    {
      "args": [
        "   c  at   t y     p  in  g   "
      ],
      "expected": "g"
    },
    {
      "args": [
        "12345678901234567890123456789012345678901234567890"
      ],
      "expected": "12345678901234567890123456789012345678901234567890"
    },
    {
      "args": [
        "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
      ],
      "expected": "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
    },
    {
      "args": [
        "@------------------------------------------------@"
      ],
      "expected": "@@"
    },
    {
      "args": [
        "@-------------------------------------------------"
      ],
      "expected": "@"
    },
    {
      "args": [
        "-------------------------------------------------@"
      ],
      "expected": "@"
    },
    {
      "args": [
        "------foo bar--------"
      ],
      "expected": "bar"
    },
    {
      "args": [
        "two programmers walked into a foobar."
      ],
      "expected": "foobar"
    },
    {
      "args": [
        "afterwards they bletched!"
      ],
      "expected": "bletched"
    },
    {
      "args": [
        "&h1j2h3h4j4k5nm5h6m7"
      ],
      "expected": "h1j2h3h4j4k5nm5h6m7"
    },
    {
      "args": [
        "(quiet)           LOUD!!!!"
      ],
      "expected": "LOUD"
    },
    {
      "args": [
        "---a"
      ],
      "expected": "a"
    },
    {
      "args": [
        "fhqwhgads -----"
      ],
      "expected": "fhqwhgads"
    },
    {
      "args": [
        "123  00"
      ],
      "expected": "00"
    },
    {
      "args": [
        "a--b"
      ],
      "expected": "ab"
    },
    {
      "args": [
        "failed -- -- -- - - - - -"
      ],
      "expected": "failed"
    },
    {
      "args": [
        "a"
      ],
      "expected": "a"
    },
    {
      "args": [
        "a:b"
      ],
      "expected": "b"
    },
    {
      "args": [
        "a!--"
      ],
      "expected": "a"
    }
  ]
}
