{
  "method": "pretty",
  "cases": [
    {
      "args": [
        "((a*b)+(c*d))"
      ],
      "expected": "a*b+c*d"
    },
    {
      "args": [
        "((w+x)+(y+z))"
      ],
      "expected": "w+x+y+z"
    },
    {
      "args": [
        "((s*t)/(m*n))"
      ],
      "expected": "s*t/(m*n)"
    },
    {
      "args": [
        "((q^r)^(f^g))"
      ],
      "expected": "(q^r)^f^g"
    },
    {
      "args": [
        "(((((a+b)/c)*d)^e)-f)"
      ],
      "expected": "((a+b)/c*d)^e-f"
    },
    {
      "args": [
        "(a-(b/(c^d)))"
      ],
      "expected": "a-b/c^d"
    },
    {
      "args": [
        "(e*((f+(g+h))*i))"
      ],
      "expected": "e*(f+g+h)*i"
    },
    {
      "args": [
        "(((a-(b-c))-d)^((e/f)/(g/h)))"
      ],
      "expected": "(a-(b-c)-d)^(e/f/(g/h))"
    },
    {
      "args": [
        "x"
      ],
      "expected": "x"
    },
    {
      "args": [
        "((a+((l-g)+o))^((r/i)*((t/h)*m)))"
      ],
      "expected": "(a+l-g+o)^(r/i*t/h*m)"
    },
    {
      "args": [
        "z"
      ],
      "expected": "z"
    },
    {
      "args": [
        "(a-(b-(c-d)))"
      ],
      "expected": "a-(b-(c-d))"
    },
    {
      "args": [
        "((u-d)*(((m/c)/y)+((z*(x-(l/e)))-((p+a)-(w*v)))))"
      ],
      "expected": "(u-d)*(m/c/y+z*(x-l/e)-(p+a-w*v))"
    },
    {
      "args": [
        "((v^h)/((p+b)/(((u-(w-((r+z)^f)))-(m^d))+(l-y))))"
      ],
      "expected": "v^h/((p+b)/(u-(w-(r+z)^f)-m^d+l-y))"
    },
    {
      "args": [
        "((((n/(r*k))+(h-(i^(l^(c/z)))))/e)*((u*(x/o))*j))"
      ],
      "expected": "(n/(r*k)+h-i^l^(c/z))/e*u*x/o*j"
    },
    {
      "args": [
        "(((((t-(k/(o*m)))*(c*f))*((n/j)+(v-z)))^l)/(x-h))"
      ],
      "expected": "((t-k/(o*m))*c*f*(n/j+v-z))^l/(x-h)"
    },
    {
      "args": [
        "(a+b)"
      ],
      "expected": "a+b"
    },
    {
      "args": [
        "(c-d)"
      ],
      "expected": "c-d"
    },
    {
      "args": [
        "(e*f)"
      ],
      "expected": "e*f"
    },
    {
      "args": [
        "(g/h)"
      ],
      "expected": "g/h"
    },
    {
      "args": [
        "(i^j)"
      ],
      "expected": "i^j"
    },
    {
      "args": [
        "((h-q)/s)"
      ],
      "expected": "(h-q)/s"
    },
    {
      "args": [
        "(v/(k/w))"
      ],
      "expected": "v/(k/w)"
    },
    {
      "args": [
        "(g+(t^y))"
      ],
      "expected": "g+t^y"
    },
    {
      "args": [
        "((p/o)+(e*i))"
      ],
      "expected": "p/o+e*i"
    },
    {
      "args": [
        "(z/((d-r)^a))"
      ],
      "expected": "z/(d-r)^a"
    },
    {
      "args": [
        "(n^((x^l)/m))"
      ],
      "expected": "n^(x^l/m)"
    },
    {
      "args": [
        "((((j+b)-u)-f)*c)"
      ],
      "expected": "(j+b-u-f)*c"
    },
    {
      "args": [
        "(w-(d+((h^g)/y)))"
      ],
      "expected": "w-(d+h^g/y)"
    },
    {
      "args": [
        "(((z-b)/f)-(i^x))"
      ],
      "expected": "(z-b)/f-i^x"
    },
    {
      "args": [
        "((l^u)*((t/m)-(k+r)))"
      ],
      "expected": "l^u*(t/m-(k+r))"
    },
    {
      "args": [
        "((v/j)+(a^(s/(p/e))))"
      ],
      "expected": "v/j+a^(s/(p/e))"
    },
    {
      "args": [
        "(q*((((c*n)+o)-j)*p))"
      ],
      "expected": "q*(c*n+o-j)*p"
    },
    {
      "args": [
        "(((g*z)/(w-(t^s)))-(b*r))"
      ],
      "expected": "g*z/(w-t^s)-b*r"
    },
    {
      "args": [
        "((q/y)-((c^h)+(v-(x/o))))"
      ],
      "expected": "q/y-(c^h+v-x/o)"
    },
    {
      "args": [
        "(((n+u)+(l-a))-(e-(f/i)))"
      ],
      "expected": "n+u+l-a-(e-f/i)"
    },
    {
      "args": [
        "(m/((((k+d)-((i^x)-w))+a)*s))"
      ],
      "expected": "m/((k+d-(i^x-w)+a)*s)"
    },
    {
      "args": [
        "((d*(e-l))+(u/(v+(j^(f+y)))))"
      ],
      "expected": "d*(e-l)+u/(v+j^(f+y))"
    },
    {
      "args": [
        "((((k/o)-(m-n))^b)+(c*(h*r)))"
      ],
      "expected": "(k/o-(m-n))^b+c*h*r"
    },
    {
      "args": [
        "(((z+((p^q)-t))*(g+((c^w)+i)))-a)"
      ],
      "expected": "(z+p^q-t)*(g+c^w+i)-a"
    },
    {
      "args": [
        "((((m^(u-p))*t)/(n*((b+f)-q)))-e)"
      ],
      "expected": "m^(u-p)*t/(n*(b+f-q))-e"
    },
    {
      "args": [
        "((((v-(y^(h/l)))+(s*d))/(o^x))-k)"
      ],
      "expected": "(v-y^(h/l)+s*d)/o^x-k"
    },
    {
      "args": [
        "((j*g)/(c/((r-w)*(e^(a/((z^t)*s))))))"
      ],
      "expected": "j*g/(c/((r-w)*e^(a/(z^t*s))))"
    },
    {
      "args": [
        "((d+((b^x)*((i+k)-((q-u)+y))))/(m/c))"
      ],
      "expected": "(d+b^x*(i+k-(q-u+y)))/(m/c)"
    },
    {
      "args": [
        "(((z/(((l*o)*g)^(v*r)))/(n*f))-(p^h))"
      ],
      "expected": "z/(l*o*g)^(v*r)/(n*f)-p^h"
    },
    {
      "args": [
        "(a+(((u*(j+z))/(k*((d/n)/((b/x)^i))))-y))"
      ],
      "expected": "a+u*(j+z)/(k*d/n/(b/x)^i)-y"
    },
    {
      "args": [
        "((((g-e)+(r*h))/f)/((m*c)^(l/(v*(w^o)))))"
      ],
      "expected": "(g-e+r*h)/f/(m*c)^(l/(v*w^o))"
    },
    {
      "args": [
        "((((((q*s)/t)-p)*r)-(v^(w-((g+y)*u))))+f)"
      ],
      "expected": "(q*s/t-p)*r-v^(w-(g+y)*u)+f"
    },
    {
      "args": [
        "((((q+(c+k))/((f*a)+(i*(j^d))))*(e-(l-b)))+m)"
      ],
      "expected": "(q+c+k)/(f*a+i*j^d)*(e-(l-b))+m"
    },
    {
      "args": [
        "((((o*n)+((h+t)/s))/((z*x)*(((r-g)*q)-e)))-b)"
      ],
      "expected": "(o*n+(h+t)/s)/(z*x*((r-g)*q-e))-b"
    },
    {
      "args": [
        "(((((((d/k)+(f^a))*(x^(o-c)))+(s+u))^y)^b)*z)"
      ],
      "expected": "(((d/k+f^a)*x^(o-c)+s+u)^y)^b*z"
    },
    {
      "args": [
        "((p^(((q-a)-(v-w))*j))-((((m-t)^((i/l)^d))*o)^u))"
      ],
      "expected": "p^((q-a-(v-w))*j)-((m-t)^(i/l)^d*o)^u"
    },
    {
      "args": [
        "((e/(j-r))/(f-(z/((y-(s*w))^((i*h)-(u/(m^g)))))))"
      ],
      "expected": "e/(j-r)/(f-z/(y-s*w)^(i*h-u/m^g))"
    },
    {
      "args": [
        "((q*v)*((((a/(b+n))-(t/k))/((c/x)*(p+(h-j))))-s))"
      ],
      "expected": "q*v*((a/(b+n)-t/k)/(c/x*(p+h-j))-s)"
    },
    {
      "args": [
        "(((n+(u+j))+y)*((((t-k)-r)*(d-((g-f)*q)))*(c/i)))"
      ],
      "expected": "(n+u+j+y)*(t-k-r)*(d-(g-f)*q)*c/i"
    },
    {
      "args": [
        "((((v+w)-(x+z))+(a-(l*o)))^(e*(((p+m)^(h+b))*s)))"
      ],
      "expected": "(v+w-(x+z)+a-l*o)^(e*(p+m)^(h+b)*s)"
    },
    {
      "args": [
        "((((z-y)+x)-n)+(p/((r^c)^((((o-q)*g)-a)^(d-b)))))"
      ],
      "expected": "z-y+x-n+p/(r^c)^((o-q)*g-a)^(d-b)"
    },
    {
      "args": [
        "((((s^(h-j))-i)^t)^((((m/f)+((e^w)^l))*k)^(u+v)))"
      ],
      "expected": "((s^(h-j)-i)^t)^((m/f+(e^w)^l)*k)^(u+v)"
    },
    {
      "args": [
        "(((y/f)+((d^((((s-o)-v)-z)/h))^k))+(p+(w*(b^q))))"
      ],
      "expected": "y/f+(d^((s-o-v-z)/h))^k+p+w*b^q"
    },
    {
      "args": [
        "(((a*i)*(x/(m/(l+r))))*(((c/g)/(j^(t-(n-u))))-e))"
      ],
      "expected": "a*i*x/(m/(l+r))*(c/g/j^(t-(n-u))-e)"
    },
    {
      "args": [
        "((a*q)+(((((((r/k)-h)-u)-(n/e))-o)/(l-v))-(c-s)))"
      ],
      "expected": "a*q+(r/k-h-u-n/e-o)/(l-v)-(c-s)"
    },
    {
      "args": [
        "(((b+f)*((t*((g+m)^p))^(((j+x)*(i^y))*w)))-(d^z))"
      ],
      "expected": "(b+f)*(t*(g+m)^p)^((j+x)*i^y*w)-d^z"
    },
    {
      "args": [
        "(((f/g)+c)/(h*((e*a)-(((u/p)+(k+n))+(i^(o^y))))))"
      ],
      "expected": "(f/g+c)/(h*(e*a-(u/p+k+n+i^o^y)))"
    },
    {
      "args": [
        "(((((d+z)*m)/j)-((t*w)-(v/(s-(r/l)))))^((x*q)^b))"
      ],
      "expected": "((d+z)*m/j-(t*w-v/(s-r/l)))^(x*q)^b"
    },
    {
      "args": [
        "((k*((m+(v+s))*(x^g)))^((w*(d-(b/((c-t)-u))))/n))"
      ],
      "expected": "(k*(m+v+s)*x^g)^(w*(d-b/(c-t-u))/n)"
    },
    {
      "args": [
        "((((p+r)-(h+l))*(f-q))*((e-i)*(((y+o)^z)-(j*a))))"
      ],
      "expected": "(p+r-(h+l))*(f-q)*(e-i)*((y+o)^z-j*a)"
    },
    {
      "args": [
        "((((((k^p)^y)+x)+(a+(b^h)))+((u*o)/f))*((j/e)^m))"
      ],
      "expected": "((k^p)^y+x+a+b^h+u*o/f)*(j/e)^m"
    },
    {
      "args": [
        "((((z/g)^(r-(q+l)))^v)+((s/d)*(((c+i)+t)+(w-n))))"
      ],
      "expected": "((z/g)^(r-(q+l)))^v+s/d*(c+i+t+w-n)"
    },
    {
      "args": [
        "(b/((r^((x+u)^(t-l)))/((((a-w)-(d^e))-o)+(z*h))))"
      ],
      "expected": "b/(r^(x+u)^(t-l)/(a-w-d^e-o+z*h))"
    },
    {
      "args": [
        "x"
      ],
      "expected": "x"
    },
    {
      "args": [
        "(((((t-(k/(o*m)))*(c*f))*((n/j)+(v-z)))^l)/(x-h))"
      ],
      "expected": "((t-k/(o*m))*c*f*(n/j+v-z))^l/(x-h)"
    },
    {
      "args": [
        "(((a-(b-c))-d)^((e/f)/(g/h)))"
      ],
      "expected": "(a-(b-c)-d)^(e/f/(g/h))"
    }
  ]
}
